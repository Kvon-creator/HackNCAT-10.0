APP_ENV=development
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:5173
DEMO_SESSION_SECRET=replace-with-a-long-random-local-secret
DEMO_SESSION_MINUTES=60
DATABASE_URL=postgresql://aggieconnect_runtime:password@localhost:5432/aggieconnect
# Live Entra settings are required when implementing/enabling live authentication:
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_CLIENT_SECRET=
ENTRA_SPA_CLIENT_ID=
# AI classifier (Dev 3). Server-side only: never commit a real key or expose it via VITE_ variables.
# Leave blank to use the labeled rule-based fallback classifier.
OPENAI_MODEL=
OPENAI_API_KEY=
